# Start MongoDB locally, or replace this with your MongoDB Atlas connection URI.
# Do not share your .env file or commit it to Git.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=rescueplan
HOST=127.0.0.1
PORT=8000
# false for local HTTP; true only when serving over HTTPS.
COOKIE_SECURE=false
SESSION_HOURS=8

